# --- Application Config ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# --- Security (Hackathon Demos) ---
# Comma-separated list of valid mock tokens
VALID_API_TOKENS=mock_token_123,demo_user_456

# --- Infrastructure / Database URLs ---
POSTGRES_URL=postgresql://agentrx_user:agentrx_pass@localhost:5432/agentrx_db
REDIS_URL=redis://localhost:6379/0
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agentrx_neo4j

# --- External APIs ---
PUBMED_API_KEY=your_pubmed_key_here
USPTO_API_KEY=your_uspto_key_here

# --- LLM Config ---
LLM_PROVIDER=mistral
LLM_MODEL_NAME=mistral-large-latest
MISTRAL_API_KEY=your_mistral_api_key_here

# --- AWS / MinIO Settings ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=agentrx-reports
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin